{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {"api/entry.js": {"maxDuration": 60}},
  "rewrites": [
    {"source":"/api/:path*","destination":"/api/entry?__route=/api/:path*"},
    {"source":"/uploads/:path*","destination":"/api/entry?__route=/uploads/:path*"}
  ],
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"Referrer-Policy","value":"same-origin"}]}]
}
